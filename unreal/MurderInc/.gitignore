# Unreal build products and caches: regenerated by tools/box/build.sh and by the editor.
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Build/
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
*.sln
*.code-workspace
.vs/
.vscode/
.idea/

# Generated binary content (.uasset, .umap, imported meshes and textures) lives only on the box.
# Committed under Content/: the exported data and the editor scripts that regenerate everything else.
/Content/*
!/Content/Data/
/Content/Data/*
!/Content/Data/*.json
!/Content/Data/golden/
/Content/Data/golden/*
!/Content/Data/golden/*.json
!/Content/Python/
/Content/Python/*
!/Content/Python/*.py

# Audio (docs/unreal/AUDIO.md): the voice takes and the generated material are committed as WAV (small, under
# 40 MB in all); the web game's rendered sounds (Content/Audio/Web) are regenerated by node tools/ue-export/audio.mjs;
# the imported .uasset files are made on the box by tools/box/audio-import.sh.
!/Content/Audio/
/Content/Audio/*
!/Content/Audio/Voice/
!/Content/Audio/Gen/
/Content/Audio/Voice/**/*.uasset
/Content/Audio/Gen/*.uasset
