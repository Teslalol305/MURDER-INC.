  "compatibility": {
    "about": "Per gun and slot: `options` the player may fit, `default` the choice of a new build (null = the factory part, no effect), `required` true when the slot can never be empty (then `default` is one of `options`). A slot a gun does not list does not exist on that gun and is not shown.",
    "chopper": {
      "optic": { "options": ["scope"], "default": null, "required": false, "mount": "Optic", "note": "the 106 mm rail on the top cover; the iron sights stay and the scope sits on the rail ahead of the rear sight" },
      "muzzle": { "options": ["silencer"], "default": null, "required": false, "mount": "MuzzleMount", "note": "replaces the muzzle booster" }
    },
    "nine": {
      "laser": { "options": ["laser"], "default": null, "required": false, "mount": "Laser", "note": "the accessory rail under the dust cover" }
    },
    "stick": {
      "optic": { "options": ["irons", "scope"], "default": "irons", "required": true, "mount": "Optic" },
      "muzzle": { "options": ["silencer"], "default": null, "required": false, "mount": "MuzzleMount" },
      "underbarrel": { "options": ["grip_vertical", "grip_angled"], "default": null, "required": false, "mount": "Underbarrel" },
      "laser": { "options": ["laser"], "default": null, "required": false, "mount": "Laser" },
      "magazine": { "options": ["mag_standard", "mag_clear"], "default": "mag_standard", "required": true, "mount": "MagHinge" },
      "handguard": { "options": ["hg_short", "hg_default", "hg_extended"], "default": "hg_default", "required": true, "mount": "Handguard" },
      "stock": { "options": ["stock_open", "stock_folded"], "default": "stock_open", "required": true, "mount": "Stock" }
    },
    "rattler": {
      "muzzle": { "options": ["silencer"], "default": null, "required": false, "mount": "MuzzleMount", "note": "replaces the slotted muzzle device. No optic: the 70 mm top rail is shorter than the scope's mount. No laser: the weapon light fills the handguard" }
    }
  }
