{
  "meta": {
    "file": "attachments.json",
    "about": "Weapon attachments (docs/unreal/LOADOUT.md section 3.3): the seven slots, the stats an attachment may change, every attachment with its rule effects and its art, and the per-gun compatibility table. Adding an attachment is one entry in `attachments` plus its id in the `compatibility` rows of the guns it fits; adding a gun is one row in `compatibility`.",
    "game": "MURDER INC.",
    "schema": 1,
    "units": "effects are in the web units of the stat (config.json: metres, seconds, radians, vertical degrees); `mul` values are plain factors",
    "ops": "Per stat, the effects of every fitted attachment are applied in this order: every `set` (in slot order; the later slot wins), then the sum of every `add`, then the product of every `mul`, then every `min` (the smallest wins), then every `max`, then the stat's clamp. An attachment with no effects changes nothing: the factory part and the baseline choices are such attachments.",
    "rule": "Every attachment that is not `baseline` has at least one effect that makes its stat better and one that makes a stat worse (by the stat's `better` direction). MurderInc.Loadout.DataLoads checks it: there is no best build."
  },
  "slots": [
    { "id": "optic", "order": 1, "text": "frontend.attachments.slots.optic", "focus": "optic" },
    { "id": "muzzle", "order": 2, "text": "frontend.attachments.slots.muzzle", "focus": "muzzle" },
    { "id": "underbarrel", "order": 3, "text": "frontend.attachments.slots.underbarrel", "focus": "underbarrel" },
    { "id": "laser", "order": 4, "text": "frontend.attachments.slots.laser", "focus": "laser" },
    { "id": "magazine", "order": 5, "text": "frontend.attachments.slots.magazine", "focus": "magazine" },
    { "id": "handguard", "order": 6, "text": "frontend.attachments.slots.handguard", "focus": "handguard" },
    { "id": "stock", "order": 7, "text": "frontend.attachments.slots.stock", "focus": "stock" }
  ],
  "stats": {
    "adsTime": { "targets": ["adsTime"], "unit": "s", "better": "lower", "clamp": [0.08, 0.6], "text": "frontend.effects.adsTime" },
    "adsFov": { "targets": ["extra.adsFov"], "unit": "vertical degrees", "better": "none", "clamp": [20, 60], "text": "frontend.effects.adsFov", "note": "a narrower aimed view is a trade, neither better nor worse" },
    "adsLook": { "targets": ["extra.adsLook"], "unit": "factor", "better": "none", "clamp": [0.3, 1.5], "text": null, "note": "keeps the aimed look speed in step with a narrower view; not shown as an effect" },
    "spread.hip": { "targets": ["spread.hip"], "unit": "rad", "better": "lower", "clamp": [0.002, 0.04], "text": "frontend.effects.spreadHip" },
    "spread.moveHip": { "targets": ["spread.moveHip"], "unit": "rad", "better": "lower", "clamp": [0.0, 0.04], "text": "frontend.effects.spreadMoveHip" },
    "spread.ads": { "targets": ["spread.ads"], "unit": "rad", "better": "lower", "clamp": [0.0003, 0.01], "text": "frontend.effects.spreadAds" },
    "spread.moveAds": { "targets": ["spread.moveAds"], "unit": "rad", "better": "lower", "clamp": [0.0, 0.02], "text": "frontend.effects.spreadMoveAds" },
    "recoil.pitch": { "targets": ["recoil.pitch", "recoil.shake", "kick.rise", "kick.back"], "unit": "rad (camera climb per round)", "better": "lower", "clamp": [0.001, 0.02], "text": "frontend.effects.recoilPitch", "note": "the camera kick, the shake and the gun's rise and push-back follow one factor, so what the player sees is what the aim does" },
    "recoil.yaw": { "targets": ["recoil.yaw", "recoil.yawEarly", "recoil.weaveAmp", "recoil.weaveRandom", "kick.yaw", "kick.roll"], "unit": "rad (sideways)", "better": "lower", "clamp": [0.0, 0.01], "text": "frontend.effects.recoilYaw", "note": "a target the gun does not have (yaw on a weaving gun, weave on the NINE) is skipped" },
    "swapTime": { "targets": ["extra.holster", "extra.draw"], "unit": "s", "better": "lower", "clamp": [0.12, 0.6], "text": "frontend.effects.swapTime" },
    "reloadTime": { "targets": ["reload.*"], "unit": "s (every mark and both lengths)", "better": "lower", "clamp": [0.5, 4.0], "text": "frontend.effects.reloadTime", "note": "every reload mark is scaled by the same factor, so the clip plays at 1 / factor and its notifies stay on the marks" },
    "noise": { "targets": ["extra.noise"], "unit": "m", "better": "lower", "clamp": [5, 90], "text": "frontend.effects.noise" },
    "flash": { "targets": ["flash.scale", "flash.light"], "unit": "factor", "better": "lower", "clamp": [0.0, 2.0], "text": "frontend.effects.flash" },
    "falloff.start": { "targets": ["extra.falloff.start"], "unit": "m", "better": "higher", "clamp": [5, 1000], "text": "frontend.effects.falloff", "note": "a gun without falloff starts from start = end = infinity, min = 1" },
    "falloff.end": { "targets": ["extra.falloff.end"], "unit": "m", "better": "higher", "clamp": [5, 1000], "text": null },
    "falloff.min": { "targets": ["extra.falloff.min"], "unit": "share of damage", "better": "higher", "clamp": [0.3, 1.0], "text": "frontend.effects.falloffMin" },
    "length": { "targets": ["wallPull"], "unit": "factor on both distances", "better": "lower", "clamp": [0.3, 2.0], "text": "frontend.effects.length", "note": "a longer gun pulls back from walls sooner" },
    "sway": { "targets": ["swayMax"], "unit": "factor", "better": "lower", "clamp": [0.02, 0.2], "text": "frontend.effects.sway", "note": "presentation: the gun's look sway; the aim does not sway in the web rules" }
  },
