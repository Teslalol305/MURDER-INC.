    "pistol_magout": { "web": 0.4, "layers": [ { "files": ["Gen/pistol_magout_01.wav"], "vol": 0.8 } ] },
    "pistol_magin": { "web": 0.4, "layers": [ { "files": ["Gen/pistol_magin_01.wav"], "vol": 0.8 } ] },
    "pistol_slide": { "web": 0.4, "layers": [ { "files": ["Gen/pistol_slide_01.wav"], "vol": 0.85 } ] },
    "brass_asphalt": { "web": 0.5, "layers": [ { "files": ["Gen/brass_asphalt_01.wav", "Gen/brass_asphalt_02.wav", "Gen/brass_asphalt_03.wav"], "vol": 0.7 } ] },
    "brass_concrete": { "web": 0.0, "category": "world", "ref": 1.6, "roll": 1.4, "fallback": "brass_asphalt", "layers": [ { "files": ["Gen/brass_concrete_01.wav", "Gen/brass_concrete_02.wav", "Gen/brass_concrete_03.wav"], "vol": 0.7 } ] },
    "imp_concrete": { "web": 0.5, "layers": [ { "files": ["Gen/imp_concrete_01.wav", "Gen/imp_concrete_02.wav", "Gen/imp_concrete_03.wav"], "vol": 0.8 } ] },
    "imp_brick": { "web": 0.5, "layers": [ { "files": ["Gen/imp_brick_01.wav", "Gen/imp_brick_02.wav"], "vol": 0.8 } ] },
