From 6fd2f5576bf403a08e0e584891e4eee0e6fce419 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 03:44:39 +0000
Subject: [PATCH 4/4] Blood: a new decal skips every pool still under a body (a
 burst after a grenade's kills took the pools and they vanished at once)

Not built or tested yet: the GPU box ended before this change was made.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HkcHdD7NbyxwnFfuuSpZY4
---
 .../Source/MurderInc/Weapons/MIEffects.cpp    | 19 +++++++++++++++++--
 .../Source/MurderInc/Weapons/MIEffects.h      |  1 +
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.cpp b/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.cpp
index 2ccd8f2..5eabf21 100644
--- a/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.cpp
+++ b/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.cpp
@@ -284,8 +284,23 @@ int32 UMIEffects::Blood(const FVector& Point, const FVector& Normal, double Size
 	{
 		return 0;
 	}
-	FBlood& X = Bloods[NextBlood];
-	NextBlood = (NextBlood + 1) % Bloods.Num();
+	// Round the ring from the next slot, past every pool still under a body (a burst at a living Goon after a grenade's
+	// kills would otherwise take the pools while the bodies lie there, and they would vanish at once); when every slot
+	// is a live pool, the next one is taken anyway.
+	int32 Pick = NextBlood;
+	for (int32 K = 0; K < Bloods.Num(); ++K)
+	{
+		const int32 I = (NextBlood + K) % Bloods.Num();
+		const FBlood& B = Bloods[I];
+		if (!(B.bPool && B.Age < B.Life))
+		{
+			Pick = I;
+			break;
+		}
+	}
+	FBlood& X = Bloods[Pick];
+	NextBlood = (Pick + 1) % Bloods.Num();
+	X.bPool = Kind > 1.1 && Kind < 1.4;
 	X.Age = 0.0;
 	X.Life = Life;
 	X.Size0 = Size0;
diff --git a/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.h b/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.h
index f613112..aca01b7 100644
--- a/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.h
+++ b/unreal/MurderInc/Source/MurderInc/Weapons/MIEffects.h
@@ -121,6 +121,7 @@ private:
 		TObjectPtr<UMaterialInstanceDynamic> Mat;
 		double Age = 1e9, Life = 40.0, Size0 = 40.0, Size1 = 40.0, Grow = 0.0, FadeOut = 3.0;
 		int32 Serial = 0;
+		bool bPool = false;  // a pool under a body: never taken by a later spatter while it lasts
 	};
 	struct FStreak
 	{
-- 
2.43.0

