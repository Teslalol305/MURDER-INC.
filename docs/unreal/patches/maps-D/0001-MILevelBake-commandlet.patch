+#pragma once
+
+#include "Commandlets/Commandlet.h"
+#include "MILevelBakeCommandlet.generated.h"
+
+/**
+ * The engine bake of a new level file (docs/unreal/MAPS.md lane D, item D2):
+ *
+ *   UnrealEditor-Cmd MurderInc.uproject -run=MILevelBake -In=<level_<id>.json> [-Out=<file>] [-Report=<file>]
+ *
+ * Reads the layout tool's file (tools/levels/data/level_<id>.json), fills an FMIBoxWorld with its colliders and writes
+ * back, with the runtime's own code and nothing re-implemented:
+ *  - `nav.layers[*].grid` for every "plane" layer (FMIBoxWorld::RebuildNav through NavCols/NavRows/NavBlocked, the
+ *    same rows format as level.json `nav.grid`), with cols, rows, free and blocked;
+ *  - for "boxes" layers (roofs), the grid only when nav step A's per-layer build exists (MAPS.md N1, compiled in with
+ *    MI_WITH_NAV_LAYERS); until then the layer keeps `grid: null` and the report says so;
+ *  - the cover filter: cover points on a plane layer that are not on a walkable cell are dropped and listed;
+ *  - the reach report: FindPath from playerStart to each objective and to the extraction when both are on the street
+ *    plane (Canal), and every ground spawn's walkability on its layer.
+ * The Block's level.json is never an input: its nav comes from the web exporter.
+ */
+UCLASS()
+class UMILevelBakeCommandlet : public UCommandlet
+{
+	GENERATED_BODY()
+
+public:
+	UMILevelBakeCommandlet();
+	virtual int32 Main(const FString& Params) override;
+};
